# ConstructConnect API
CONSTRUCTCONNECT_API_KEY=your_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_key_here

# Pipeline tuning
MIN_PROJECT_VALUE=5000000        # $5M minimum to ingest
SEARCH_STATES=UT                 # Comma-separated: UT,NV,ID
SEARCH_DAYS_BACK=90              # Look back window
MAX_LEADS_PER_RUN=20             # Top N leads to surface per run
